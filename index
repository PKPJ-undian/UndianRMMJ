<script>


const state = {

apiUrl:'',

apiKey:'',

lastTables:{}

};



window.addEventListener(
'DOMContentLoaded',
async function(){


bindNav();


state.apiUrl =
localStorage.getItem(
'stu_api_url'
) || '';


state.apiKey =
localStorage.getItem(
'stu_api_key'
) || '';


document
.getElementById('apiUrl')
.value =
state.apiUrl;


document
.getElementById('apiKey')
.value =
state.apiKey;


if(
state.apiUrl &&
state.apiKey
){

await testApi(false);

await loadDashboard();

}

}
);



function bindNav(){


document
.querySelectorAll(
'.nav button'
)
.forEach(

function(btn){


btn.addEventListener(
'click',
function(){


document
.querySelectorAll(
'.nav button'
)
.forEach(
function(b){

b.classList.remove(
'active'
);

}
);


document
.querySelectorAll(
'.page'
)
.forEach(
function(p){

p.classList.remove(
'active'
);

}
);


btn.classList.add(
'active'
);


document
.getElementById(
btn.dataset.page
)
.classList.add(
'active'
);


document
.getElementById(
'pageTitle'
)
.textContent =
btn.textContent;


const page =
btn.dataset.page;


if(
page === 'dashboard'
){

loadDashboard();

}


if(
page === 'watchlist'
){

loadData(
'watchlist',
'watchTable'
);

}


if(
page === 'ditapis'
){

loadData(
'filtered',
'filteredTable'
);

}


if(
page === 'audit'
){

loadData(
'audit',
'auditTable'
);

}


}
);

}
);

}



/* ==========================================
   API CALL
========================================== */

async function api(payload){


if(
!state.apiUrl ||
!state.apiKey
){

throw new Error(
'Sila isi Tetapan API dahulu.'
);

}


const res =
await fetch(

state.apiUrl,

{

method:'POST',

redirect:'follow',

headers:{
'Content-Type':
'text/plain;charset=utf-8'
},

body:
JSON.stringify({

...payload,

key:
state.apiKey

})

}

);


const text =
await res.text();


let data;


try{

data =
JSON.parse(text);

}

catch(e){

throw new Error(
'Respons API tidak sah. Pastikan URL Web App berakhir dengan /exec.'
);

}


if(!data.ok){

throw new Error(
data.error ||
'Operasi gagal.'
);

}


return data;

}



/* ==========================================
   TEST API
========================================== */

async function testApi(
show=true
){

try{


const data =
await api({
action:'health'
});


setApiStatus(
true,
data.app +
' ' +
data.version
);


if(show){

toast(
'Sambungan API berjaya.',
'good'
);

}


return true;


}

catch(err){


setApiStatus(
false,
'API gagal'
);


if(show){

toast(
err.message,
'bad'
);

}


return false;

}

}



/* ==========================================
   STATUS API
========================================== */

function setApiStatus(
ok,
text
){

const el =
document
.getElementById(
'apiStatus'
);


el.className =
'status' +
(ok ? ' ok' : '');


el.textContent =
ok
?
'API aktif · ' + text
:
text;

}



/* ==========================================
   SIMPAN API
========================================== */

async function saveApiSettings(){


state.apiUrl =
document
.getElementById(
'apiUrl'
)
.value
.trim();


state.apiKey =
document
.getElementById(
'apiKey'
)
.value
.trim();


localStorage.setItem(
'stu_api_url',
state.apiUrl
);


localStorage.setItem(
'stu_api_key',
state.apiKey
);


await testApi(true);

}



/* ==========================================
   PADAM API
========================================== */

function clearApiSettings(){


localStorage.removeItem(
'stu_api_url'
);


localStorage.removeItem(
'stu_api_key'
);


state.apiUrl = '';

state.apiKey = '';


document
.getElementById(
'apiUrl'
)
.value = '';


document
.getElementById(
'apiKey'
)
.value = '';


setApiStatus(
false,
'API belum disambung'
);


toast(
'Tetapan API dipadam daripada browser.',
'info'
);

}



/* ==========================================
   DASHBOARD
========================================== */

async function loadDashboard(){


if(
!state.apiUrl ||
!state.apiKey
){

return;

}


try{


const d =
await api({
action:'dashboard'
});


document
.getElementById(
'mProjects'
)
.textContent =
d.summary.projects || 0;


document
.getElementById(
'mApplicants'
)
.textContent =
d.summary.applicants || 0;


document
.getElementById(
'mWatch'
)
.textContent =
d.summary.watchlist || 0;


document
.getElementById(
'mWinners'
)
.textContent =
d.summary.winners || 0;


document
.getElementById(
'mFiltered'
)
.textContent =
d.summary.filtered || 0;


renderProjects(
d.projects || {}
);


}

catch(err){

toast(
err.message,
'bad'
);

}

}



/* ==========================================
   PROJECT SUMMARY
========================================== */

function renderProjects(
projects
){

const root =
document
.getElementById(
'projectSummary'
);


const names =
Object.keys(
projects
);


if(
!names.length
){

root.innerHTML =
'<div class="muted">Belum ada data.</div>';

return;

}


root.innerHTML =
names.map(

function(p){


const types =
projects[p];


const chips =
Object.keys(types)
.map(

function(t){


const x =
types[t];


return (

'<span class="chip">' +

'<b>' +
esc(t) +
'</b>' +

' · ' +
x.total +
' rekod' +

' · ' +
x.layak +
' layak' +

' · ' +
x.tidakLayak +
' ditapis' +

' · ' +
x.berjaya +
' berjaya' +

'</span>'

);

}

)
.join('');


return (

'<div class="projectbox">' +

'<h3>' +
esc(p) +
'</h3>' +

'<div class="typechips">' +
chips +
'</div>' +

'</div>'

);

}

)
.join('');

}



