/* ==========================================
   RENDER TABLE
========================================== */

function renderTable(
targetId,
rows
){


state.lastTables[
targetId
] =
rows;


const root =
document
.getElementById(
targetId
);


if(
!rows ||
!rows.length
){

root.innerHTML =
'<div style="padding:18px" class="muted">Tiada rekod.</div>';

return;

}


const headers =
Object.keys(
rows[0]
);


const head =
headers
.map(

function(h){

return (

'<th>' +

esc(
h.replaceAll(
'_',
' '
)
)

+

'</th>'

);

}

)
.join('');


const body =
rows
.map(

function(r){

return (

'<tr>' +

headers
.map(

function(h){

return (

'<td>' +

formatCell(
h,
r[h]
)

+

'</td>'

);

}

)
.join('')

+

'</tr>'

);

}

)
.join('');


root.innerHTML =

'<table>' +

'<thead>' +

'<tr>' +
head +
'</tr>' +

'</thead>' +

'<tbody>' +
body +
'</tbody>' +

'</table>';

}



/* ==========================================
   FORMAT CELL
========================================== */

function formatCell(
key,
val
){


let text =
val == null
?
''
:
String(val);


if(
key.includes('AT') ||
key === 'TIMESTAMP'
){

text =
formatDate(text);

}


const u =
text.toUpperCase();


if(
u === 'TIDAK LAYAK'
){

return (
'<span class="badge red">TIDAK LAYAK</span>'
);

}


if(
u === 'BERJAYA'
){

return (
'<span class="badge green">BERJAYA</span>'
);

}


if(
u === 'PERLU JEJAK'
){

return (
'<span class="badge orange">PERLU JEJAK</span>'
);

}


if(
u === 'LAYAK'
){

return (
'<span class="badge blue">LAYAK</span>'
);

}


return esc(text);

}



/* ==========================================
   FORMAT TARIKH
========================================== */

function formatDate(v){


const d =
new Date(v);


if(
isNaN(d)
){

return v;

}


return d.toLocaleString(
'ms-MY'
);

}



/* ==========================================
   DOWNLOAD CSV
========================================== */

function downloadTableCsv(
targetId,
filename
){


const rows =
state.lastTables[
targetId
] || [];


if(
!rows.length
){

toast(
'Tiada data untuk dimuat turun.',
'bad'
);

return;

}


const ws =
XLSX
.utils
.json_to_sheet(
rows
);


const csv =
XLSX
.utils
.sheet_to_csv(
ws
);


const blob =
new Blob(
[
'\uFEFF' +
csv
],
{
type:
'text/csv;charset=utf-8'
}
);


const a =
document
.createElement('a');


a.href =
URL.createObjectURL(
blob
);


a.download =
filename;


a.click();


setTimeout(
function(){

URL.revokeObjectURL(
a.href
);

},
1000
);

}



/* ==========================================
   TOAST
========================================== */

function toast(
msg,
type='info'
){


const root =
document
.getElementById(
'toast'
);


root.innerHTML =

'<div class="notice ' +
type +
'" ' +

'style="' +
'position:fixed;' +
'right:20px;' +
'bottom:20px;' +
'max-width:420px;' +
'z-index:9999;' +
'box-shadow:0 12px 30px rgba(0,0,0,.15)' +
'">' +

esc(msg) +

'</div>';


setTimeout(
function(){

root.innerHTML = '';

},
5000
);

}



/* ==========================================
   ESCAPE HTML
========================================== */

function esc(v){


return String(
v == null
?
''
:
v
)

.replace(
/[&<>'"]/g,

function(c){

return {

'&':'&amp;',

'<':'&lt;',

'>':'&gt;',

"'":'&#39;',

'"':'&quot;'

}[c];

}

);

}


