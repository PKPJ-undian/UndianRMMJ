input.files[0];


if(!file){

throw new Error(
'Sila pilih fail dahulu.'
);

}


const buf =
await file.arrayBuffer();


const wb =
XLSX.read(
buf,
{
type:'array'
}
);


const ws =
wb.Sheets[
wb.SheetNames[0]
];


return XLSX
.utils
.sheet_to_json(
ws,
{
defval:''
}
);

}



